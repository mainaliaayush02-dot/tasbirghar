# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# firebase emulators
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
pubsub-debug.log*
.firebase/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Firebase Admin / Google service-account credentials — never commit.
# Use FIREBASE_ADMIN_* in .env.local (see .env.example) instead.
*-firebase-adminsdk-*.json
*service-account*.json
*serviceAccount*.json
*credentials*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
