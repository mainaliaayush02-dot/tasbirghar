rules_version = '2';

// TasbirGhar Firestore rules. Deny by default.
// Tests: npm run test:rules (Firestore emulator). Deploy only after they pass:
//   npx firebase-tools deploy --only firestore:rules --project tasbirghar-f285b
// See docs/ARCHITECTURE.md → "Security".
//
// Principles
// - Roles come from the Auth custom claim `role` (set only by server code via
//   the Admin SDK). users/{uid}.role is a read-only mirror for the UI: clients
//   may only ever create it as "customer" and can never change it.
// - Sensitive writes happen server-side (Admin SDK bypasses these rules):
//   studio creation (slug reservation, commission), moderation, bookings,
//   reviews, and every MediaAsset field (written by the media confirm step
//   after verifying the asset with Cloudinary).
// - Admins are READ-ONLY here. Admin mutations go through server routes so
//   they can be validated and audited.
// - Client updates use field ALLOWLISTS: any field not listed is immutable.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    function incoming() { return request.resource.data; }

    // The update touches only the given fields.
    function onlyChanges(fields) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isNonNegativeInt(value) { return value is int && value >= 0; }

    function studio(studioId) {
      return get(/databases/$(database)/documents/studios/$(studioId)).data;
    }
    function ownsStudio(studioId) {
      return signedIn() && studio(studioId).ownerId == request.auth.uid;
    }
    function canReadStudioContent(studioId) {
      return studio(studioId).listingStatus == 'published' || ownsStudio(studioId) || isAdmin();
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Self sign-up always starts as a customer, with no studio or photo.
      allow create: if isSelf(uid)
        && incoming().keys().hasOnly(['role', 'displayName', 'email', 'phone', 'photo',
                                      'studioId', 'createdAt', 'updatedAt'])
        && incoming().role == 'customer'
        && incoming().studioId == null
        && incoming().photo == null;

      // Customers edit their own profile text only. role, studioId, photo,
      // email and timestamps are server-managed.
      allow update: if isSelf(uid)
        && onlyChanges(['displayName', 'phone', 'updatedAt']);

      allow delete: if false;
    }

    // -------------------------------------------------------------- studios
    match /studios/{studioId} {
      allow read: if resource.data.listingStatus == 'published'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      // Created only by server code (onboarding API), which atomically reserves
      // studioSlugs/{slug} and sets server-controlled fields (commissionRateBps,
      // stats, statuses) — a client create could otherwise set its own
      // commission rate.
      allow create: if false;

      // Owners edit profile text. ownerId, slug, statuses, stats, pricing
      // summary, commission, currency and media are server/admin controlled.
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && onlyChanges(['businessName', 'description', 'phone', 'email', 'location',
                        'categories', 'facilities', 'props', 'updatedAt']);

      allow delete: if false;

      // Portfolio & gallery docs are created by the server media confirm
      // step; owners may edit presentation fields but never the image.
      match /portfolio/{photoId} {
        allow read: if canReadStudioContent(studioId);
        allow create: if false;
        allow update: if ownsStudio(studioId)
          && onlyChanges(['caption', 'category', 'sortOrder', 'isFeatured', 'updatedAt']);
        allow delete: if ownsStudio(studioId);
      }

      match /gallery/{imageId} {
        allow read: if canReadStudioContent(studioId);
        allow create: if false;
        allow update: if ownsStudio(studioId)
          && onlyChanges(['caption', 'sortOrder', 'updatedAt']);
        allow delete: if ownsStudio(studioId);
      }

      // Owners manage package details and prices (bookings snapshot the price
      // server-side); package images are attached by the server confirm step.
      match /packages/{packageId} {
        allow read: if canReadStudioContent(studioId);
        allow create: if ownsStudio(studioId)
          && incoming().keys().hasOnly(['studioId', 'name', 'description', 'category', 'price',
                                        'currency', 'durationMinutes', 'editedPhotos',
                                        'includes', 'images', 'isActive', 'sortOrder',
                                        'createdAt', 'updatedAt'])
          && incoming().studioId == studioId
          && incoming().images == []
          && incoming().currency == 'NPR'
          && isNonNegativeInt(incoming().price);
        allow update: if ownsStudio(studioId)
          && onlyChanges(['name', 'description', 'category', 'price', 'durationMinutes',
                          'editedPhotos', 'includes', 'isActive', 'sortOrder', 'updatedAt'])
          && isNonNegativeInt(incoming().price);
        allow delete: if ownsStudio(studioId);
      }

      // One doc per day, id = "YYYY-MM-DD". Booking code must re-validate
      // slots server-side; owner-edited slot statuses are never trusted.
      match /availability/{date} {
        allow read: if canReadStudioContent(studioId);
        allow create: if ownsStudio(studioId)
          && incoming().keys().hasOnly(['studioId', 'date', 'isClosed', 'slots',
                                        'createdAt', 'updatedAt'])
          && incoming().studioId == studioId
          && incoming().date == date;
        allow update: if ownsStudio(studioId)
          && onlyChanges(['isClosed', 'slots', 'updatedAt']);
        allow delete: if ownsStudio(studioId);
      }
    }

    // Slug reservations are created server-side together with the studio.
    // Single lookups are public (slug availability / routing); listing is not,
    // so draft studios cannot be enumerated.
    match /studioSlugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // ------------------------------------------------------------- bookings
    // Created/updated only by server code (price + commission computed there).
    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.studioOwnerId == request.auth.uid
        || isAdmin());
      allow write: if false;
    }

    // -------------------------------------------------------------- reviews
    // Created server-side only after a completed booking (doc id = bookingId).
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published'
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || isAdmin();
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
