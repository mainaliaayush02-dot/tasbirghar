rules_version = '2';

// TasbirGhar Firestore rules. Deny by default.
// Tests: npm run test:rules (Firestore emulator). Deploy only after they pass:
//   npx firebase-tools deploy --only firestore:rules --project tasbirghar-f285b
// See docs/ARCHITECTURE.md → "Security".
//
// Principles
// - Roles come from the Auth custom claim `role` (set only by server code via
//   the Admin SDK). users/{uid}.role is a read-only mirror for the UI: clients
//   may only ever create it as "customer" and can never change it.
// - Sensitive writes happen server-side (Admin SDK bypasses these rules):
//   studio creation (slug reservation, commission, private sub-documents),
//   studio contact details, availability, moderation, bookings,
//   reviews, and every MediaAsset field (written by the media confirm step
//   after verifying the asset with Cloudinary).
// - Admins are READ-ONLY here. Admin mutations go through server routes so
//   they can be validated and audited.
// - Client updates use field ALLOWLISTS: any field not listed is immutable.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    function incoming() { return request.resource.data; }

    // The update touches only the given fields.
    function onlyChanges(fields) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isNonNegativeInt(value) { return value is int && value >= 0; }

    function studio(studioId) {
      return get(/databases/$(database)/documents/studios/$(studioId)).data;
    }
    // Ownership comes from users/{uid}.studioId, which only server code writes
    // (in the studio-creation transaction): clients must create it as null and
    // it is not in the users update allowlist. The public studio doc carries
    // no ownerId; server code uses studios/{id}/private/internal.ownerId.
    function ownsStudio(studioId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studioId == studioId;
    }
    function canReadStudioContent(studioId) {
      return studio(studioId).listingStatus == 'published' || ownsStudio(studioId) || isAdmin();
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Self sign-up always starts as a customer, with no studio or photo.
      allow create: if isSelf(uid)
        && incoming().keys().hasOnly(['role', 'displayName', 'email', 'phone', 'photo',
                                      'studioId', 'createdAt', 'updatedAt'])
        && incoming().role == 'customer'
        && incoming().studioId == null
        && incoming().photo == null;

      // Customers edit their own profile text only. role, studioId, photo,
      // email and timestamps are server-managed.
      allow update: if isSelf(uid)
        && onlyChanges(['displayName', 'phone', 'updatedAt']);

      allow delete: if false;

      // In-app notifications. Created only by server code, in the same
      // transaction as the booking/review event; marked read only through
      // POST /api/notifications/read. A user can read (get/list) only their
      // own; no client — not even the owner or an admin — can write them.
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // -------------------------------------------------------------- studios
    // studios/{studioId} is the PUBLIC document (anyone may read it once
    // published), so it holds marketplace fields only. Contact details, the
    // owner id, commission and moderation data live in private/* below.
    match /studios/{studioId} {
      allow read: if resource.data.listingStatus == 'published'
        || ownsStudio(studioId)
        || isAdmin();

      // Created only by server code (onboarding API), which atomically reserves
      // studioSlugs/{slug} and writes the private sub-documents — a client
      // create could otherwise set its own commission rate.
      allow create: if false;

      // Owners edit profile text. Slug, statuses, stats, pricing summary,
      // currency and media are server/admin controlled. Contact fields are not
      // allowed here (they belong in private/contact), and `location` may only
      // hold public keys, so private data can never be put on the public doc.
      allow update: if ownsStudio(studioId)
        && onlyChanges(['businessName', 'description', 'location',
                        'categories', 'facilities', 'props', 'updatedAt'])
        && incoming().location.keys().hasOnly(['city', 'area', 'geo']);

      allow delete: if false;

      // Private sub-documents, written only by server code:
      //   private/contact   phone, email, street address, website, instagram
      //                     readable by the studio owner and admins
      //   private/internal  ownerId, commissionRateBps, lastModeration
      //                     readable by admins only
      // Single-document reads only; never listable, never client-writable.
      match /private/{docId} {
        allow get: if (docId == 'contact' && (ownsStudio(studioId) || isAdmin()))
          || (docId == 'internal' && isAdmin());
        allow list: if false;
        allow write: if false;
      }

      // Portfolio & gallery docs are created by the server media confirm
      // step; owners may edit presentation fields but never the image.
      match /portfolio/{photoId} {
        allow read: if canReadStudioContent(studioId);
        allow create: if false;
        allow update: if ownsStudio(studioId)
          && onlyChanges(['caption', 'category', 'sortOrder', 'isFeatured', 'updatedAt']);
        allow delete: if ownsStudio(studioId);
      }

      match /gallery/{imageId} {
        allow read: if canReadStudioContent(studioId);
        allow create: if false;
        allow update: if ownsStudio(studioId)
          && onlyChanges(['caption', 'sortOrder', 'updatedAt']);
        allow delete: if ownsStudio(studioId);
      }

      // Owners manage package details and prices (bookings snapshot the price
      // server-side); package images are attached by the server confirm step.
      match /packages/{packageId} {
        allow read: if canReadStudioContent(studioId);
        allow create: if ownsStudio(studioId)
          && incoming().keys().hasOnly(['studioId', 'name', 'description', 'category', 'price',
                                        'currency', 'durationMinutes', 'editedPhotos',
                                        'includes', 'images', 'isActive', 'sortOrder',
                                        'createdAt', 'updatedAt'])
          && incoming().studioId == studioId
          && incoming().images == []
          && incoming().currency == 'NPR'
          && isNonNegativeInt(incoming().price);
        allow update: if ownsStudio(studioId)
          && onlyChanges(['name', 'description', 'category', 'price', 'durationMinutes',
                          'editedPhotos', 'includes', 'isActive', 'sortOrder', 'updatedAt'])
          && isNonNegativeInt(incoming().price);
        allow delete: if ownsStudio(studioId);
      }

      // One doc per day, id = "YYYY-MM-DD". Written ONLY by the server
      // (PUT/DELETE /api/studios/{id}/availability/{date}), which validates
      // the slots (30-minute steps, no overlaps, bookable dates) and edits
      // under the studio-day booking lock, refusing changes that would strand
      // a pending/confirmed booking. Rules cannot express those checks, so
      // direct client writes are closed. Existing bookings stay the final
      // authority for conflicts either way.
      match /availability/{date} {
        allow read: if canReadStudioContent(studioId);
        allow write: if false;
      }
    }

    // Slug reservations are created server-side together with the studio.
    // Single lookups are public (slug availability / routing); listing is not,
    // so draft studios cannot be enumerated.
    match /studioSlugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // ------------------------------------------------------------- bookings
    // Created/updated only by server code (price + commission computed there).
    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.studioOwnerId == request.auth.uid
        || isAdmin());
      allow write: if false;
    }

    // -------------------------------------------------------------- reviews
    // Created server-side only after a completed booking (doc id = bookingId).
    // Public pages read a safe projection (rating, comment, display name,
    // date) server-side, so the raw document — with customerId and bookingId —
    // is readable only by the review's own customer and by admins. Created
    // (pending_moderation) and moderated only by server code.
    match /reviews/{reviewId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
